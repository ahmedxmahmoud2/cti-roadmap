---
// Progress bars for every level and track, plus export / import / reset.
import { groups, lists } from '../data/roadmap';
import { pageLang, ui, localHref } from '../data/ui';

const lang = pageLang(Astro);
const t = ui(lang);
const idsFor = (g: string) =>
	lists
		.filter((l) => l.group === g && l.kind !== 'self')
		.flatMap((l) => l.items.map((i) => i.id))
		.join(',');
const levels = groups.filter((g) => !g.track);
const tracks = groups.filter((g) => g.track);
---

<div class="ctir-overview not-content">
	<div class="ctir-rows">
		{
			levels.map((g) => (
				<a class="ctir-row" href={localHref(lang, g.href)} data-ctir-count={idsFor(g.id)}>
					<span class="ctir-row-name">
						<bdi>{lang === 'ar' ? g.ar : g.en}</bdi>
					</span>
					<span class="ctir-list-count" data-ctir-label data-of={t.of} />
					<span class="ctir-bar">
						<span />
					</span>
				</a>
			))
		}
	</div>

	<p class="ctir-muted">{t.tracksHint}</p>
	<div class="ctir-rows">
		{
			tracks.map((g) => (
				<div class="ctir-row ctir-track" data-track={g.id} data-ctir-count={idsFor(g.id)}>
					<a class="ctir-row-name" href={localHref(lang, g.href)}>
						<bdi>{lang === 'ar' ? g.ar : g.en}</bdi>
					</a>
					<span class="ctir-list-count" data-ctir-label data-of={t.of} />
					<button type="button" class="ctir-pin" data-pin={g.id} data-label-pin={t.pin} data-label-unpin={t.unpin}>
						{t.pin}
					</button>
					<span class="ctir-bar">
						<span />
					</span>
				</div>
			))
		}
	</div>

	<div class="ctir-actions">
		<button type="button" data-export>{t.export}</button>
		<label class="ctir-import">
			{t.import}
			<input type="file" accept="application/json" data-import hidden />
		</label>
		<button type="button" data-reset data-confirm={t.resetConfirm}>{t.reset}</button>
	</div>
	<p class="ctir-muted" data-import-msg data-ok={t.importOk} data-bad={t.importBad}>{t.saved}</p>
</div>

<script>
	import { init, load, save, isState } from './progress';

	function refreshPins() {
		const s = load();
		const rows = document.querySelectorAll<HTMLElement>('.ctir-track');
		rows.forEach((row) => {
			const pinned = s.tracks.includes(row.dataset.track!);
			row.toggleAttribute('data-pinned', pinned);
			const btn = row.querySelector<HTMLButtonElement>('[data-pin]')!;
			btn.textContent = pinned ? btn.dataset.labelUnpin! : btn.dataset.labelPin!;
			btn.setAttribute('aria-pressed', String(pinned));
		});
		// pinned tracks first
		const parent = rows[0]?.parentElement;
		if (parent) {
			[...rows]
				.sort((a, b) => Number(b.hasAttribute('data-pinned')) - Number(a.hasAttribute('data-pinned')))
				.forEach((r) => parent.appendChild(r));
		}
	}

	document.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const s = load();
			const id = btn.dataset.pin!;
			s.tracks = s.tracks.includes(id) ? s.tracks.filter((x) => x !== id) : [...s.tracks, id];
			save(s);
		});
	});

	document.querySelector('[data-export]')?.addEventListener('click', () => {
		const blob = new Blob([JSON.stringify({ app: 'cti-roadmap', ...load() }, null, 2)], { type: 'application/json' });
		const a = document.createElement('a');
		a.href = URL.createObjectURL(blob);
		a.download = 'cti-roadmap-progress.json';
		a.click();
		URL.revokeObjectURL(a.href);
	});

	const msg = document.querySelector<HTMLElement>('[data-import-msg]');
	document.querySelector<HTMLInputElement>('[data-import]')?.addEventListener('change', async (e) => {
		const file = (e.target as HTMLInputElement).files?.[0];
		if (!file || !msg) return;
		try {
			const data = JSON.parse(await file.text());
			if (!isState(data)) throw new Error('bad');
			save({ done: data.done, tracks: Array.isArray(data.tracks) ? data.tracks : [], bg: data.bg });
			msg.textContent = msg.dataset.ok!;
		} catch {
			msg.textContent = msg.dataset.bad!;
		}
	});

	document.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', (e) => {
		const btn = e.currentTarget as HTMLButtonElement;
		if (window.confirm(btn.dataset.confirm)) save({ done: {}, tracks: [] });
	});

	document.addEventListener('ctir:change', refreshPins);
	init();
	refreshPins();
</script>
