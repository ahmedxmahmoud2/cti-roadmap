---
// "Where are you coming from?" — picks a starting level and remembers it.
import { backgrounds, groups } from '../data/roadmap';
import { pageLang, ui, localHref } from '../data/ui';

const lang = pageLang(Astro);
const t = ui(lang);
const groupName = Object.fromEntries(groups.map((g) => [g.id, lang === 'ar' ? g.ar : g.en]));
const groupHref = Object.fromEntries(groups.map((g) => [g.id, localHref(lang, g.href)]));
---

<div class="ctir-wizard not-content">
	<p class="ctir-wizard-q">{t.wizardQ}</p>
	<div class="ctir-wizard-opts" role="radiogroup" aria-label={t.wizardQ}>
		{
			backgrounds.map((b) => (
				<button type="button" role="radio" aria-checked="false" data-bg={b.id}>
					{lang === 'ar' ? b.ar : b.en}
				</button>
			))
		}
	</div>
	{
		backgrounds.map((b) => (
			<div class="ctir-wizard-result" data-result={b.id} hidden>
				<p>
					<strong>
						{t.wizardStart} <bdi>{groupName[b.start]}</bdi>
					</strong>
				</p>
				<p>{lang === 'ar' ? b.noteAr : b.noteEn}</p>
				<a class="ctir-btn" href={groupHref[b.start]}>
					{t.wizardGo} <bdi>{groupName[b.start]}</bdi>
				</a>
			</div>
		))
	}
</div>

<script>
	import { load, save } from './progress';

	function show(bg?: string) {
		document.querySelectorAll<HTMLButtonElement>('.ctir-wizard [data-bg]').forEach((b) => {
			b.setAttribute('aria-checked', String(b.dataset.bg === bg));
		});
		document.querySelectorAll<HTMLElement>('.ctir-wizard [data-result]').forEach((r) => {
			r.hidden = r.dataset.result !== bg;
		});
	}

	document.querySelectorAll<HTMLButtonElement>('.ctir-wizard [data-bg]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const s = load();
			s.bg = btn.dataset.bg;
			save(s);
			show(s.bg);
		});
	});
	show(load().bg);
</script>
